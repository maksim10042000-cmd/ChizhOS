// ChizhOS — Fleet Management System
// Рабочая (не демонстрационная) схема базы данных.
//
// Провайдер по умолчанию — SQLite: база лежит одним файлом (data/chizhos.db),
// не требует отдельного сервера БД и разворачивается на любом VPS.
// Переход на PostgreSQL: заменить provider на "postgresql" и DATABASE_URL
// в .env, затем `npm run prisma:migrate` (см. INSTALL.md, раздел «База данных»).
//
// SQLite не поддерживает enum, поэтому перечисления хранятся строками —
// допустимые значения перечислены в комментарии у каждого поля,
// а на уровне приложения их гарантируют типы из src/lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Пользователи и доступ
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  login        String  @unique
  passwordHash String
  name         String
  // admin — полный доступ ко всем паркам
  // manager — Park Manager: полный доступ в пределах своего парка
  // user — доступ к своему парку и только к разрешённым разделам
  role         String  @default("user")
  parkId       String?
  park         Park?   @relation(fields: [parkId], references: [id], onDelete: SetNull)
  blocked      Boolean @default(false)
  // Разрешённые разделы через запятую (только для роли user).
  // Пустая строка = разделы по умолчанию для роли.
  permissions  String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AuthSession[]

  @@index([parkId])
}

model AuthSession {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Автопарки
// ---------------------------------------------------------------------------

model Park {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  cars     Car[]
  drivers  Driver[]
  users    User[]
  expenses Expense[]
}

// ---------------------------------------------------------------------------
// Водители
// ---------------------------------------------------------------------------

model Driver {
  id        String  @id @default(cuid())
  fullName  String
  phone     String?
  parkId    String?
  park      Park?   @relation(fields: [parkId], references: [id], onDelete: SetNull)
  licenseNo String?
  passport  String?
  address   String?
  deposit   Int     @default(0)
  comment   String?
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars      Car[]
  payments  Payment[]
  documents Document[]

  @@index([parkId])
}

// ---------------------------------------------------------------------------
// Автомобили
// ---------------------------------------------------------------------------

model Car {
  id     String  @id @default(cuid())
  plate  String  @unique
  brand  String
  model  String
  year   Int?
  parkId String
  park   Park    @relation(fields: [parkId], references: [id], onDelete: Cascade)
  // on — на линии, idle — в простое
  status String  @default("on")

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  // Пробег, км
  mileage   Int @default(0)
  // Пробег за последние 30 дней, км (для расчёта стоимости километра)
  mileMonth Int @default(0)
  // Суточная ставка аренды, ₽
  rate      Int @default(0)

  // Дата окончания страховки — из неё считается «страховка заканчивается»
  insuranceUntil DateTime?
  // Пробег, на котором предстоит следующее ТО — из него считается «скоро ТО»
  nextServiceKm  Int?

  // Индивидуальный процент управляющего по этому автомобилю, 0..100.
  // null — процент не задан, применяется общий из Settings.managerPercent.
  // Дробные значения допустимы (например, 8.5).
  managerPercent Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  Payment[]
  expenses  Expense[]
  documents Document[]

  @@index([parkId, status])
  @@index([driverId])
}

// ---------------------------------------------------------------------------
// Платежи по аренде
// ---------------------------------------------------------------------------

model Payment {
  id       String  @id @default(cuid())
  carId    String
  car      Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  // Дата, за которую начислен платёж
  date     DateTime
  amount   Int
  paid     Boolean   @default(false)
  paidAt   DateTime?
  // Наличные | Карта | Перевод
  method   String    @default("Карта")
  comment  String?

  createdAt DateTime @default(now())

  @@index([carId, date])
  @@index([date, paid])
}

// ---------------------------------------------------------------------------
// Расходы
// ---------------------------------------------------------------------------

model Expense {
  id    String  @id @default(cuid())
  // Привязка к авто; если пусто — общий расход
  carId String?
  car   Car?    @relation(fields: [carId], references: [id], onDelete: Cascade)
  // Парк для общего расхода (если пусто — расход по всей компании)
  parkId String?
  park   Park?   @relation(fields: [parkId], references: [id], onDelete: SetNull)

  // to | parts | wash | tire | insurance | fine | other
  cat     String
  name    String
  amount  Int
  date    DateTime
  comment String?

  createdAt DateTime @default(now())

  @@index([carId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Документы (авто и водителей)
// ---------------------------------------------------------------------------

model Document {
  id String @id @default(cuid())
  // vehicle — документы автомобиля, driver — документы водителя
  kind String

  carId String?
  car   Car?    @relation(fields: [carId], references: [id], onDelete: Cascade)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: Cascade)

  // СТС, ПТС, Договор аренды, Полис, Диагностическая карта…
  docType String?
  name    String
  // Ключ/URL файла: /uploads/... локально либо публичный URL S3/R2
  url     String
  mime    String?
  size    Int?

  uploadedAt DateTime @default(now())

  @@index([carId])
  @@index([driverId])
}

// ---------------------------------------------------------------------------
// Скрытые уведомления
// ---------------------------------------------------------------------------

model DismissedNotification {
  // Ключ уведомления (тип + id сущности), совпадает с AppNotification.id
  key         String   @id
  dismissedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Настройки (единственная строка, id = 1)
// ---------------------------------------------------------------------------

model Settings {
  id      Int    @id @default(1)
  orgName String @default("ChizhOS")
  // Процент управляющего по умолчанию для всего автопарка, 0..100.
  // Применяется к автомобилям, у которых не задан собственный процент.
  managerPercent Float @default(10)

  updatedAt DateTime @updatedAt
}
